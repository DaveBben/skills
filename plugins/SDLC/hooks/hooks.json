{
  "hooks": {
    "SessionStart": [{
      "hooks": [{"type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/writing.md\""}]
    }],
    "SubagentStart": [{
      "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-writing.sh\""}]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "if": "Bash(*git*)", "command": "f=\"${CLAUDE_PLUGIN_ROOT}/skills/deliver/scripts/guard.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\""}]
    }, {
      "matcher": "Bash",
      "hooks": [{"type": "command", "if": "Bash(*merge*)", "command": "f=\"${CLAUDE_PLUGIN_ROOT}/skills/deliver/scripts/guard.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\""}]
    }, {
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [{"type": "command", "command": "f=\"${CLAUDE_PLUGIN_ROOT}/skills/orient/scripts/size_guard.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\""}]
    }],
    "PostToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "if": "Bash(*.md*)", "command": "f=\"${CLAUDE_PLUGIN_ROOT}/skills/orient/scripts/size_guard.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\""}]
    }]
  }
}
