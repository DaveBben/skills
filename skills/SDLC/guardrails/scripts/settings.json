{
  "hooks": {
    "Stop": [{
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py stop", "timeout": 600}]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "if": "Bash(*create*)", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py pr", "timeout": 3600}]
    }, {
      "matcher": "mcp__.*(pull|merge)_request.*",
      "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.py pr", "timeout": 3600}]
    }]
  }
}
